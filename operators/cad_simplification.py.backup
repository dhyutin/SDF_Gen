        """
        # Use operator property if it exists, otherwise use parameter
        if hasattr(self, 'recalculate_normals'):
            recalculate = self.recalculate_normals

        if not recalculate:
            return

        # Ensure object is selected and active
        bpy.ops.object.select_all(action='DESELECT')
        obj.select_set(True)
        bpy.context.view_layer.objects.active = obj

        # Switch to edit mode
